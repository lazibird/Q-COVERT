# Optional checkout-local dependencies shared by root and standalone builds.
include_guard(GLOBAL)
get_filename_component(QCOVERT_REPOSITORY_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(QCOVERT_DEPENDENCY_ROOT "${QCOVERT_REPOSITORY_ROOT}/.deps/usr" CACHE PATH "Optional local development dependency prefix")
if(EXISTS "${QCOVERT_DEPENDENCY_ROOT}")
    set(Boost_NO_BOOST_CMAKE ON)
    list(PREPEND CMAKE_PREFIX_PATH "${QCOVERT_DEPENDENCY_ROOT}")
    list(PREPEND CMAKE_LIBRARY_PATH "${QCOVERT_DEPENDENCY_ROOT}/lib/x86_64-linux-gnu")
    list(PREPEND CMAKE_INCLUDE_PATH "${QCOVERT_DEPENDENCY_ROOT}/include")
    include_directories("${QCOVERT_DEPENDENCY_ROOT}/include")
    link_directories("${QCOVERT_DEPENDENCY_ROOT}/lib/x86_64-linux-gnu")
    set(ENV{PKG_CONFIG_PATH} "${QCOVERT_DEPENDENCY_ROOT}/lib/x86_64-linux-gnu/pkgconfig:$ENV{PKG_CONFIG_PATH}")
    list(APPEND CMAKE_BUILD_RPATH "${QCOVERT_DEPENDENCY_ROOT}/lib/x86_64-linux-gnu" "${QCOVERT_DEPENDENCY_ROOT}/lib/x86_64-linux-gnu/blas" "${QCOVERT_DEPENDENCY_ROOT}/lib/x86_64-linux-gnu/lapack")
endif()
set(QCOVERT_PYTHON_ENV "${QCOVERT_REPOSITORY_ROOT}/.venv" CACHE PATH "Shared Python environment and optional MKL installation")
if(EXISTS "${QCOVERT_PYTHON_ENV}/include/mkl.h")
    set(MKL_PATH "${QCOVERT_PYTHON_ENV}/lib" CACHE PATH "MKL libraries")
    set(MKL_INCLUDE_PATH "${QCOVERT_PYTHON_ENV}/include" CACHE PATH "MKL headers")
    set(OMP_PATH "${QCOVERT_PYTHON_ENV}/lib" CACHE PATH "Intel OpenMP libraries")
    list(APPEND CMAKE_BUILD_RPATH "${MKL_PATH}" "${OMP_PATH}")
endif()
