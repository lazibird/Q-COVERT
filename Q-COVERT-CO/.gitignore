############################
# General ignore rules
############################

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo
*.bak
*.orig

# Files generated by the operating system
.DS_Store
Thumbs.db

############################
# C/C++ build artifacts
############################

# Object files, executables, shared libraries, and static libraries
*.o
*.obj
*.lo
*.la
*.a
*.so
*.so.*
*.dll
*.dylib
*.exe
*.out
*.app
*.fvecs
*.ivecs
*.Ivecs
*.index
# Debug symbols
*.dSYM/
*.pdb

############################
# CMake and build directories
############################

CMakeFiles/
CMakeCache.txt
cmake-build-*/
build/
build-*/
out/
dist/
bin/
compass/
V-ORAM/
data/
############################
# Python and virtual environments
############################

__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/
rabitq_env/

############################
# IDE and editor settings
############################

.vscode/
.idea/
*.user
*.suo
*.sln.iml

############################
# Project-specific files
############################

# Generated results and images excluded from version control
results/
retrieval_perf.png
technical_report.pdf

